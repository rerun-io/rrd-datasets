* text=auto eol=lf

# Blueprints, URDF meshes, and screenshots are binary — git-lfs carries them.
*.rbl filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text

# One big generated lockfile: no diffs, no 3-way merges.
pixi.lock merge=binary linguist-generated -diff
